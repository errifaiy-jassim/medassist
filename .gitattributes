# Normalize all text files to LF inside the repository.
# Working-tree endings still follow core.autocrlf, so Windows checkouts are unaffected.
* text=auto

*.py     text eol=lf
*.js     text eol=lf
*.jsx    text eol=lf
*.ts     text eol=lf
*.tsx    text eol=lf
*.json   text eol=lf
*.css    text eol=lf
*.html   text eol=lf
*.md     text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.ini    text eol=lf
*.txt    text eol=lf
*.env.example text eol=lf
Dockerfile text eol=lf

*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.woff binary
*.woff2 binary
*.webm binary
*.wav  binary
*.ogg  binary
