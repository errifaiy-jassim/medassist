# Backend environment — copy to backend/.env and set LOCAL values.
# NEVER commit real secrets or production credentials.

ENVIRONMENT=development

# Prefer PostgreSQL in real deployments. Local SQLite is OK for smoke tests only.
DATABASE_URL=postgresql+psycopg2://medassist_user:CHANGE_ME_DB_PASSWORD@localhost:5432/medassist_db

# Generate a long random value (32+ chars). Do not use the placeholder below in production.
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

ADMIN_INPE=INPE-000001
ADMIN_EMAIL=admin@medassist.local
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
ADMIN_FULL_NAME=Administrateur MedAssist
ADMIN_SPECIALTY=Médecine générale

CORS_ORIGINS=http://localhost:3003,http://127.0.0.1:3003

# External AI — backend-only. Clinical text is sent only to this host if allowlisted.
LLM_API_URL=http://127.0.0.1:11434/api/generate
LLM_MODEL_NAME=qwen2.5:7b
LLM_ALLOWED_HOSTS=127.0.0.1,localhost

# Local Faster-Whisper (no cloud STT unless you intentionally change this stack)
WHISPER_MODEL=small
STT_MAX_UPLOAD_BYTES=26214400

# OpenAPI docs (forced off when ENVIRONMENT=production)
ENABLE_API_DOCS=true

# Optional Hugging Face token for model downloads — keep server-side only
HF_TOKEN=
